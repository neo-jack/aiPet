# Node.js 24; 本地开发默认仅监听回环地址。
HOST=127.0.0.1
PORT=3001

# 填写 Sub2API 的 API 根地址（通常以 /v1 结尾）、专用 API key 和可用模型 ID。
# 这些值仅供后端使用；不要使用后台登录密码或 VITE_* 变量。
SUB2API_BASE_URL=
SUB2API_API_KEY=
SUB2API_MODEL=

# provider 不发送扩展参数；DeepSeek Flash 快速回复使用 disabled，开启思考使用 enabled。
MODEL_THINKING_MODE=provider

MAX_CONCURRENT_REQUESTS=2
REQUEST_TIMEOUT_MS=60000
MAX_OUTPUT_TOKENS=800
# 单进程的全站限流；不读取客户端提供的 X-Forwarded-For。
REQUESTS_PER_MINUTE=20

# 逗号分隔的完整浏览器 Origin；跨域接入须显式配置。
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# 可选外部 JSON；留空使用 src/site.config.json 的已构建版本。
SITE_CONFIG_FILE=
